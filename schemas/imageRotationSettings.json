{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intervalSeconds": {
      "type": "number",
      "minimum": 1,
      "default": 60
    },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sum": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "sum",
          "enabled"
        ]
      }
    }
  },
  "required": [
    "intervalSeconds",
    "items"
  ]
}
